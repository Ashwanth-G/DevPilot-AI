{
  "compilerOptions": {
    "target": "ES2022",

    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "allowJs": false,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,

    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",

    "paths": {
      "@/*": [
        "./src/*"
      ]
    },

    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "next.config.ts",
    "eslint.config.mjs"
  ],

  "exclude": [
    "node_modules",
    ".next"
  ]
}
