APP_NAME=DevPilot AI API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://devpilot:YOUR_DB_PASSWORD@localhost:5432/devpilot

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# JWT - generate two different secure values
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000

# OpenAI
OPENAI_API_KEY=

# GitHub
GITHUB_TOKEN=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=